#!/bin/bash
#
# timeshift-resign — make an injectable copy of a hardened-runtime .app.
#
#   timeshift-resign <source.app> <dest.app>
#
# Copies the bundle, then re-signs every Mach-O in it ad-hoc with
# com.apple.security.cs.disable-library-validation, so DYLD_INSERT_LIBRARIES
# is honoured. Existing entitlements are preserved.
#
# This always works on a copy. It never modifies the source, because
# re-signing invalidates notarization and resets the app's TCC grants
# (microphone, camera, automation), which you do not want to do to an app you
# rely on.
#
set -euo pipefail

die() { echo "timeshift-resign: $*" >&2; exit 1; }

[[ $# -eq 2 ]] || { sed -n '3,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2; }

src="$1"; dst="$2"
[[ -d "$src" ]] || die "$src is not a bundle"
[[ "$src" != "$dst" ]] || die "refusing to re-sign in place; give a different destination"
[[ -e "$dst" ]] && die "$dst already exists — remove it first"

# Two independent mechanisms have to be dealt with, and they are easy to
# confuse:
#
#   - The hardened runtime marks a process "restricted", and dyld strips every
#     DYLD_* variable from a restricted process. Waived by
#     com.apple.security.cs.allow-dyld-environment-variables.
#   - Library validation governs WHICH dylibs may load: same team, or a
#     platform binary. Waived by com.apple.security.cs.disable-library-validation.
#
# With a Developer ID we sign the copy and the shim with one identity, so
# library validation is satisfied by the team match and only the dyld-environment
# waiver is needed — the hardened runtime stays on and the result is notarizable.
# The ad-hoc fallback cannot match teams, so it drops the hardened runtime and
# disables library validation instead.
SIGN_ID="${TIMESHIFT_SIGN_ID:-$(security find-identity -v -p codesigning 2>/dev/null \
    | awk -F'"' '/Developer ID Application/ {print $2; exit}')}"
if [[ -n "$SIGN_ID" ]]; then
	sign_args=(-s "$SIGN_ID" --options runtime --timestamp)
	echo "signing identity: $SIGN_ID"
	echo "  keeping the hardened runtime; library validation satisfied by team match"
else
	sign_args=(-s -)
	echo "signing identity: ad-hoc (no Developer ID found)"
	echo "  library validation will be disabled by entitlement"
fi

ents="$(mktemp -t timeshift-ents).plist"
trap 'rm -f "$ents"' EXIT

# Start from the app's own entitlements so capabilities like audio-input survive.
# Note: plain `--entitlements -` prints a human-readable [Key] dump on current
# macOS, which is not a plist; `--xml` is what yields something plutil can read.
if codesign -d --entitlements - --xml "$src" 2>/dev/null | grep -q '<key>'; then
	codesign -d --entitlements - --xml "$src" 2>/dev/null > "$ents" \
	    || die "could not read entitlements from $src"
	plutil -convert xml1 "$ents" >/dev/null || die "entitlements from $src are not a valid plist"
else
	printf '%s' '<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict/></plist>' > "$ents"
	plutil -convert xml1 "$ents" >/dev/null
fi
add_ent() {
	/usr/libexec/PlistBuddy -c "Add :$1 bool true" "$ents" >/dev/null 2>&1 \
		|| /usr/libexec/PlistBuddy -c "Set :$1 true" "$ents" >/dev/null
}
# Needed in both paths: without it the hardened runtime (Developer ID path) or a
# future re-hardening silently discards DYLD_INSERT_LIBRARIES.
add_ent com.apple.security.cs.allow-dyld-environment-variables
if [[ -z "$SIGN_ID" ]]; then
	add_ent com.apple.security.cs.disable-library-validation
fi

echo "entitlements carried over:"
/usr/libexec/PlistBuddy -c 'Print' "$ents" | grep -E '=' | sed 's/^/    /'

echo "copying $src -> $dst"
cp -R "$src" "$dst"
xattr -dr com.apple.quarantine "$dst" 2>/dev/null || true

# Nested code must be valid before the bundle is sealed, so sign inside out.
echo "signing nested libraries..."
find "$dst" -type f \( -name '*.dylib' -o -name '*.so' \) -print0 \
	| xargs -0 -r -I{} codesign -f "${sign_args[@]}" {} 2>/dev/null || true
for fw in "$dst"/Contents/Frameworks/*.framework; do
	[[ -e "$fw" ]] && codesign -f "${sign_args[@]}" "$fw" 2>/dev/null || true
done

echo "signing executables..."
for b in "$dst"/Contents/MacOS/*; do
	[[ -f "$b" ]] || continue
	file "$b" | grep -q 'Mach-O' || continue
	codesign -f "${sign_args[@]}" --entitlements "$ents" "$b" 2>/dev/null || true
done

echo "sealing bundle..."
codesign -f "${sign_args[@]}" --entitlements "$ents" "$dst"

echo
"$(dirname "${BASH_SOURCE[0]}")/timeshift-check" "$dst"
