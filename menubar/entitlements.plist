<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WSJT-X runs as a child of this app, so TCC treats this app as the
	     responsible process for its microphone request. Under the hardened
	     runtime that request is denied outright, without a prompt, unless the
	     responsible app carries this entitlement. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
